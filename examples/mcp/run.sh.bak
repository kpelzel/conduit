#!/bin/sh
#set -e

MCP_DOCKER_PATH="/etc/conduit-mcp"

# get path of script
SCRIPT_DIR=$( cd -- "$( dirname -- "$0" )" &> /dev/null && pwd )
echo SCRIPT_DIR:$SCRIPT_DIR

# Get "global" variables
. "${SCRIPT_DIR}"/vars.sh

# run slurm docker example images
cd $SCRIPT_DIR
$DOCKER_COMPOSE up -d --force-recreate caddy

sleep 2

cp /etc/ssl/certs/ca-certificates.crt $MCP_DOCKER_PATH/openwebui-ca-bundle.pem
cat $MCP_DOCKER_PATH/caddy/caddy_data/caddy/pki/authorities/local/root.crt >> $MCP_DOCKER_PATH/openwebui-ca-bundle.pem

$DOCKER_COMPOSE up -d --force-recreate
